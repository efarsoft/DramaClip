{
  "preset_id": "karaoke-pop",
  "preset_name": "卡拉OK金句",
  "description": "逐字高亮填充，居中大字，适合字幕金句流与高潮台词。逐字节奏三档可切（rhythm.type）：karaoke=逐字高亮填充（卡拉OK灯，本预设默认）、char_reveal=逐字淡入揭示、whole_line=整行淡入；animation.entrance 独立控制进场动效（bounce/fade）。",
  "dimensions": {
    "rhythm": {
      "type": "karaoke"
    },
    "animation": {
      "entrance": "bounce",
      "fade_ms": 150
    },
    "layout": {
      "default": "center_single",
      "climax": "center_single"
    },
    "emotion_style": {
      "default": {
        "primary": "&H00FFFFFF",
        "outline": "&H00000000",
        "effect": "none"
      },
      "anger": {
        "primary": "&H000000FF",
        "outline": "&H00FFFFFF",
        "effect": "shake"
      },
      "triumph": {
        "primary": "&H0000D7FF",
        "outline": "&H00000000",
        "effect": "scale_glow"
      },
      "suspense": {
        "primary": "&H0000FFFF",
        "outline": "&H00000000",
        "effect": "none"
      }
    }
  },
  "font": {
    "size": 80,
    "bold": true,
    "outline_width": 3,
    "shadow": 1,
    "margin_v": 10
  }
}
