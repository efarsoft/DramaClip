{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/export.json",
  "title": "export 命名空间",
  "namespace": "export",
  "x-models": {
    "SelfCheckItem": {
      "type": "object",
      "required": [
        "pass"
      ],
      "properties": {
        "pass": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "三态：true=实测过线 / false=实测不过 / null=量不到（徽章灰「—」，宁灰勿假绿）"
        },
        "measured_s": {
          "type": "number"
        },
        "budget_s": {
          "type": "number"
        },
        "tolerance_s": {
          "type": "number"
        },
        "has_audio": {
          "type": "boolean"
        },
        "expected": {
          "type": "string"
        },
        "planned_segments": {
          "type": "integer"
        },
        "mean_volume_db": {
          "type": "number"
        },
        "max_freeze_s": {
          "type": "number"
        },
        "measured_top": {
          "type": "number",
          "description": "成片 OCR 到的文字带上沿（占成片高比例）"
        },
        "measured_bottom": {
          "type": "number",
          "description": "成片 OCR 到的文字带下沿（占成片高比例）"
        },
        "expected_top": {
          "type": "number",
          "description": "承诺覆盖的源台词带上沿（占画面高比例，行框并集口径）"
        },
        "expected_bottom": {
          "type": "number",
          "description": "承诺覆盖的源台词带下沿（占画面高比例，行框并集口径）"
        },
        "center_offset": {
          "type": "number",
          "description": "实测带中心 - 承诺带中心（正=偏下），画面高比例"
        },
        "cover_tolerance": {
          "type": "number",
          "description": "覆盖容差 = 承诺带半高 + OCR 边界抖动（画面高比例；与时长项的 tolerance_s 不同单位）"
        },
        "reason": {
          "type": "string"
        },
        "window_s": {
          "type": "number",
          "description": "开场（opening）专用：判定窗口长度（秒）"
        },
        "end_s": {
          "type": "number",
          "description": "收尾（ending）专用：成片最后一刀的时间点（秒）"
        },
        "line": {
          "type": "string",
          "description": "收尾（ending）专用：被拦腰那句台词的开头（≤20 字）"
        },
        "median_ms": {
          "type": "number",
          "description": "音画同步（avsync）专用：各采样点偏移的中位数（毫秒）"
        },
        "dispersion_ms": {
          "type": "number",
          "description": "音画同步（avsync）专用：偏移的离散度＝最大−最小（毫秒）"
        }
      }
    },
    "SelfCheckAvsync": {
      "description": "音画同步项：通用检查项之外带采样统计。有效采样点不足两点时只有 pass=null——不猜",
      "allOf": [
        {
          "$ref": "#/x-models/SelfCheckItem"
        },
        {
          "type": "object",
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 2,
              "description": "参与统计的有效采样点数"
            }
          }
        }
      ]
    },
    "SelfCheckCaptionResidue": {
      "description": "残字影子项（v2）：成片字幕带内出现「我们烧的字幕之外」的第二簇文字的候选帧统计。pass 恒为 null——只攒数据不改徽章，判红阈值等跨片数据到位再定",
      "allOf": [
        {
          "$ref": "#/x-models/SelfCheckItem"
        },
        {
          "type": "object",
          "properties": {
            "band_frames": {
              "type": "integer",
              "description": "字幕带内有文字的探针帧数"
            },
            "residue_frames": {
              "type": "integer",
              "description": "其中带内文字簇数 ≥2（候选）的帧数"
            },
            "samples": {
              "type": "array",
              "maxItems": 5,
              "description": "候选帧样本（最多 5 条）",
              "items": {
                "type": "object",
                "required": [
                  "film_t",
                  "rows"
                ],
                "properties": {
                  "film_t": {
                    "type": "number",
                    "description": "候选帧在成片里的时间点（秒）"
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "该帧带内各簇文字（各 ≤20 字）"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "SelfCheckLoudnessReading": {
      "type": "object",
      "description": "响度实测读数（v3）：导出链的复核门禁已经硬失败守门，这里不设徽章，只记归一后的复核实测做历史账。量不到或未配目标时成绩单上的 loudness 键为 null",
      "required": [
        "status",
        "measured_i",
        "measured_tp",
        "lra",
        "target_i",
        "target_tp",
        "deviation_lu"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "measured"
          ]
        },
        "measured_i": {
          "type": "number",
          "description": "成片综合响度实测（LUFS）"
        },
        "measured_tp": {
          "type": "number",
          "description": "真峰值实测（dBTP）"
        },
        "lra": {
          "type": "number",
          "description": "响度范围（LU）"
        },
        "target_i": {
          "type": "number",
          "description": "目标综合响度（LUFS）"
        },
        "target_tp": {
          "type": "number",
          "description": "真峰值上限（dBTP）"
        },
        "deviation_lu": {
          "type": "number",
          "description": "综合响度偏离目标的绝对值（LU）"
        }
      }
    },
    "SelfCheck": {
      "type": "object",
      "description": "成片自检成绩单（09-10 §4.5 四项 + 画面侧落位实测；engines/exporter/selfcheck.py 度量，音画判据与 scripts/verify_modes.py 同源）。caption_placement 刻意不在 required、也不进四项汇总态：四项徽章口径不变，它自己有呈现位。四项之外的后加项（safe_zone/ending/avsync/caption_residue/loudness/opening）同理：不进汇总态、不在 required（早期成绩单没有这些键）",
      "required": [
        "checked_at",
        "duration",
        "narration",
        "silence",
        "freeze"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "checked_at": {
          "type": "integer"
        },
        "duration": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "narration": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "silence": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "freeze": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "caption_placement": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "safe_zone": {
          "$ref": "#/x-models/SelfCheckItem",
          "description": "劝告项：字幕带底是否进入平台底部互动区"
        },
        "ending": {
          "$ref": "#/x-models/SelfCheckItem",
          "description": "收尾词级出点：最后一刀是否把原声对白拦腰切断"
        },
        "opening": {
          "anyOf": [
            {
              "$ref": "#/x-models/SelfCheckItem"
            },
            {
              "type": "null"
            }
          ],
          "description": "开场 3 秒质检（解说模式前窗应有可闻声）；原声模式或量不到为 null"
        },
        "avsync": {
          "$ref": "#/x-models/SelfCheckAvsync",
          "description": "音画同步（影子项）：各采样点偏移的中位数与离散度"
        },
        "caption_residue": {
          "$ref": "#/x-models/SelfCheckCaptionResidue",
          "description": "残字影子项：带内第二簇文字的候选帧统计"
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/x-models/SelfCheckLoudnessReading"
            },
            {
              "type": "null"
            }
          ],
          "description": "响度实测读数（影子项）：不设徽章，量不到为 null"
        },
        "dedup_jitter": {
          "type": "boolean",
          "description": "v4：逐片段微扰动开关状态（export.dedup_jitter）——处理链如实记录，成片可自证"
        }
      }
    },
    "ExportJob": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "status",
        "progress",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        },
        "narration_plan_id": {
          "type": "string"
        },
        "selfcheck": {
          "oneOf": [
            {
              "$ref": "#/x-models/SelfCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "selfcheck_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "failed",
            "partial",
            null
          ]
        },
        "compute": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/x-models/ComputeReport"
          },
          "description": "本次导出的算力回执（视频编码等）；NULL = 未记录"
        },
        "degraded_notes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "subject",
              "outcome",
              "at"
            ],
            "properties": {
              "subject": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "at": {
                "type": "number"
              }
            }
          },
          "description": "允许型降级留痕（账在库层）；NULL = 本次无降级"
        },
        "publish_data": {
          "oneOf": [
            {
              "$ref": "#/x-models/PublishData"
            },
            {
              "type": "null"
            }
          ],
          "description": "发布数据回流（W8）；NULL = 未录入"
        }
      }
    },
    "ComputeReport": {
      "type": "object",
      "required": [
        "component",
        "requested",
        "resolved",
        "actual",
        "fallback",
        "reason",
        "device"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "requested": {
          "type": "string",
          "enum": [
            "auto",
            "gpu",
            "cpu",
            "cuda",
            "xpu",
            "dml"
          ]
        },
        "resolved": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "device": {
          "type": "string"
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "project_name",
        "output_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_name": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "size_bytes": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        },
        "cover_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "NULL = 成片封面还没补拍；渲染层显示占位图，不请求 null 路径"
        },
        "narration_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "angle": {
          "type": [
            "string",
            "null"
          ],
          "description": "卖点角度名（金色标签）；方案已删或无解说模式为 null"
        },
        "episode_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "取材集（追溯链的源集区间）；方案已删为 null"
        },
        "selfcheck": {
          "oneOf": [
            {
              "$ref": "#/x-models/SelfCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "selfcheck_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "failed",
            "partial",
            null
          ]
        },
        "publish_data": {
          "oneOf": [
            {
              "$ref": "#/x-models/PublishData"
            },
            {
              "type": "null"
            }
          ],
          "description": "发布数据回流（W8）；NULL = 未录入"
        }
      }
    },
    "PublishData": {
      "type": "object",
      "required": [
        "platform",
        "plays",
        "retention_pct",
        "recorded_at"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "抖音",
            "快手",
            "视频号",
            "小红书",
            "B站",
            "其他"
          ],
          "description": "平台白名单在服务端校验"
        },
        "plays": {
          "type": "integer",
          "minimum": 0
        },
        "retention_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "完播率百分数（创作者后台展示口径）"
        },
        "likes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "shares": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "分享数（可选；视频号社交裂变主指标）"
        },
        "retention_3s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "前 3 秒留存百分数（可选；健康线判据）"
        },
        "video_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "平台作品 ID/链接（可选；同平台唯一，对账拒配）"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "发布日期 YYYY-MM-DD（可选）"
        },
        "recorded_at": {
          "type": "integer",
          "description": "录入时刻毫秒"
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "export.submit",
      "summary": "阶段4：把已规划好的方案排队渲染（一条方案一个 export job）",
      "params": {
        "type": "object",
        "required": [
          "plan_ids"
        ],
        "properties": {
          "plan_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "exports",
          "rejected"
        ],
        "properties": {
          "exports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "rejected": {
            "type": "array"
          }
        }
      }
    },
    {
      "name": "export.retry",
      "summary": "重试失败导出：复用原 export_id 覆盖写，不新建记录",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "job_id",
          "export_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "export_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "export.list",
      "summary": "项目导出记录",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/ExportJob"
        }
      }
    },
    {
      "name": "export.list_works",
      "summary": "作品库：跨项目已完成成片（附项目名/角度/取材集/自检，按完成时间倒序）",
      "params": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "partial",
              "unchecked"
            ],
            "description": "自检汇总态筛选（09-10 #30）；缺省或词表外不筛"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/WorkItem"
        }
      }
    },
    {
      "name": "export.ensure_covers",
      "summary": "作品库逐片封面补拍（幂等）：只处理已完成且无封面的成片",
      "params": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "generated": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "export.platform_covers",
      "summary": "逐平台封面重裁（小红书 3:4/B站 16:10/视频号 6:7）：源素材重截帧→成片回退，失败进 skipped 不挡发布",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "covers",
          "skipped"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "covers": {
            "type": "object",
            "description": "平台名 → 已生成封面绝对路径",
            "additionalProperties": {
              "type": "string"
            }
          },
          "skipped": {
            "type": "object",
            "description": "平台名 → 未生成原因（截帧失败）",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "export.get",
      "summary": "单条导出记录（成片详情页数据源）",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/ExportJob"
      }
    },
    {
      "name": "export.delete",
      "summary": "删除成片（§3.4 危险操作）：文件移入 <data>/.trash/<日期>/ 后删记录行",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "trashed",
          "missing"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "trashed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "实际搬入 .trash 的文件路径"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "记录指向但盘上已不存在的文件（如实报，不挡删行）"
          }
        }
      }
    },
    {
      "name": "export.selfcheck",
      "summary": "历史成片补测四项自检（job 化，幂等）：默认只处理已完成且从未自检的记录",
      "params": {
        "type": "object",
        "properties": {
          "export_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "显式重测指定条目（已有成绩单也覆盖重跑）；缺省走补测队列"
          },
          "limit": {
            "type": "integer",
            "description": "补测队列上限，钳制 1..500，默认 200"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "queued"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "queued": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "export.set_publish_data",
      "summary": "发布数据录入（W8）：观众投票是唯一外部真相源；data=null 清除录入",
      "params": {
        "type": "object",
        "required": [
          "export_id",
          "data"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "platform",
                  "plays",
                  "retention_pct"
                ],
                "properties": {
                  "platform": {
                    "type": "string",
                    "enum": [
                      "抖音",
                      "快手",
                      "视频号",
                      "小红书",
                      "B站",
                      "其他"
                    ]
                  },
                  "plays": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "retention_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "likes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "shares": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "retention_3s": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "video_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 200
                  },
                  "published_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "task_ref": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100,
                    "description": "任务后台的任务编号（对账锚）"
                  },
                  "drama_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100,
                    "description": "剧目名（对账锚）"
                  },
                  "pack_version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100,
                    "description": "素材包版本（对账锚）"
                  },
                  "publish_account": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100,
                    "description": "发布账号（对账锚）"
                  },
                  "settlement_amount": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "结算金额（对账记录，不做对账逻辑）"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "publish_data"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "publish_data": {
            "oneOf": [
              {
                "$ref": "#/x-models/PublishData"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "name": "export.publish_report",
