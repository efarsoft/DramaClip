{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/export.json",
  "title": "export 命名空间",
  "namespace": "export",
  "x-models": {
    "SelfCheckItem": {
      "type": "object",
      "required": [
        "pass"
      ],
      "properties": {
        "pass": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "三态：true=实测过线 / false=实测不过 / null=量不到（徽章灰「—」，宁灰勿假绿）"
        },
        "measured_s": {
          "type": "number"
        },
        "budget_s": {
          "type": "number"
        },
        "tolerance_s": {
          "type": "number"
        },
        "has_audio": {
          "type": "boolean"
        },
        "expected": {
          "type": "string"
        },
        "planned_segments": {
          "type": "integer"
        },
        "mean_volume_db": {
          "type": "number"
        },
        "max_freeze_s": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "SelfCheck": {
      "type": "object",
      "description": "成片自检成绩单（09-10 §4.5 四项；engines/exporter/selfcheck.py 度量，判据与 scripts/verify_modes.py 同源）",
      "required": [
        "checked_at",
        "duration",
        "narration",
        "silence",
        "freeze"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "checked_at": {
          "type": "integer"
        },
        "duration": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "narration": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "silence": {
          "$ref": "#/x-models/SelfCheckItem"
        },
        "freeze": {
          "$ref": "#/x-models/SelfCheckItem"
        }
      }
    },
    "ExportJob": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "status",
        "progress",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        },
        "narration_plan_id": {
          "type": "string"
        },
        "selfcheck": {
          "oneOf": [
            {
              "$ref": "#/x-models/SelfCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "selfcheck_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "failed",
            "partial",
            null
          ]
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "project_name",
        "output_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_name": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "size_bytes": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        },
        "cover_path": {
          "type": "string"
        },
        "narration_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "angle": {
          "type": [
            "string",
            "null"
          ],
          "description": "卖点角度名（金色标签）；方案已删或无解说模式为 null"
        },
        "episode_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "取材集（追溯链的源集区间）；方案已删为 null"
        },
        "selfcheck": {
          "oneOf": [
            {
              "$ref": "#/x-models/SelfCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "selfcheck_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "failed",
            "partial",
            null
          ]
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "export.submit",
      "summary": "阶段4：把已规划好的方案排队渲染（一条方案一个 export job）",
      "params": {
        "type": "object",
        "required": [
          "plan_ids"
        ],
        "properties": {
          "plan_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "exports",
          "rejected"
        ],
        "properties": {
          "exports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "rejected": {
            "type": "array"
          }
        }
      }
    },
    {
      "name": "export.retry",
      "summary": "重试失败导出：复用原 export_id 覆盖写，不新建记录",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "job_id",
          "export_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "export_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "export.list",
      "summary": "项目导出记录",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/ExportJob"
        }
      }
    },
    {
      "name": "export.list_works",
      "summary": "作品库：跨项目已完成成片（附项目名/角度/取材集/自检，按完成时间倒序）",
      "params": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "partial",
              "unchecked"
            ],
            "description": "自检汇总态筛选（09-10 #30）；缺省或词表外不筛"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/WorkItem"
        }
      }
    },
    {
      "name": "export.ensure_covers",
      "summary": "作品库逐片封面补拍（幂等）：只处理已完成且无封面的成片",
      "params": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "generated": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "export.get",
      "summary": "单条导出记录（成片详情页数据源）",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/ExportJob"
      }
    },
    {
      "name": "export.delete",
      "summary": "删除成片（§3.4 危险操作）：文件移入 <data>/.trash/<日期>/ 后删记录行",
      "params": {
        "type": "object",
        "required": [
          "export_id"
        ],
        "properties": {
          "export_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "trashed",
          "missing"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "trashed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "实际搬入 .trash 的文件路径"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "记录指向但盘上已不存在的文件（如实报，不挡删行）"
          }
        }
      }
    },
    {
      "name": "export.selfcheck",
      "summary": "历史成片补测四项自检（job 化，幂等）：默认只处理已完成且从未自检的记录",
      "params": {
        "type": "object",
        "properties": {
          "export_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "显式重测指定条目（已有成绩单也覆盖重跑）；缺省走补测队列"
          },
          "limit": {
            "type": "integer",
            "description": "补测队列上限，钳制 1..500，默认 200"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "queued"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "queued": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
