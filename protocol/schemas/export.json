{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/export.json",
  "title": "export 命名空间",
  "namespace": "export",
  "x-models": {
    "ExportJob": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "status",
        "progress",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "project_name",
        "output_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_name": {
          "type": "string"
        },
        "narration_mode": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "size_bytes": {
          "type": "integer"
        },
        "completed_at": {
          "type": "integer"
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "export.submit",
      "summary": "阶段4：把已规划好的方案排队渲染（一条方案一个 export job）",
      "params": {
        "type": "object",
        "required": ["plan_ids"],
        "properties": {
          "plan_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["exports", "rejected"],
        "properties": {
          "exports": {
            "type": "array",
            "items": {"type": "object" }
          },
          "rejected": {"type": "array" }
        }
      }
    },
    {
      "name": "export.retry",
      "summary": "重试失败导出：复用原 export_id 覆盖写，不新建记录",
      "params": {
        "type": "object",
        "required": ["export_id"],
        "properties": { "export_id": { "type": "string" } },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["job_id", "export_id"],
        "properties": { "job_id": { "type": "string" }, "export_id": { "type": "string" } }
      }
    },
    {
      "name": "export.list",
      "summary": "项目导出记录",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/ExportJob"
        }
      }
    },
    {
      "name": "export.list_works",
      "summary": "作品库：跨项目已完成成片（附项目名，按完成时间倒序）",
      "params": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/WorkItem"
        }
      }
    }
  ]
}