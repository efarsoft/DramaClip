{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/project.json",
  "title": "project 命名空间",
  "namespace": "project",
  "x-models": {
    "Project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_path",
        "status",
        "created_at",
        "episode_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "episode_count": {
          "type": "integer"
        },
        "cover_path": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "description": "项目级参数覆盖（方案数 K/转写档位/解说风格/字幕预设等）；空对象=全部使用全局默认。库内为 JSON 文本，仓储层解析后以对象返回（同 narration.PlanData.plan_data）"
        }
      }
    },
    "Episode": {
      "type": "object",
      "required": [
        "id",
        "episode_number",
        "name",
        "source_path",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "episode_number": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "cover_path": {
          "type": "string"
        }
      }
    },
    "ScannedEpisode": {
      "type": "object",
      "required": [
        "episode_number",
        "name",
        "source_path",
        "duration",
        "size_bytes"
      ],
      "properties": {
        "episode_number": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "size_bytes": {
          "type": "integer"
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "project.create",
      "summary": "创建项目（source_path 为剧集目录）",
      "params": {
        "type": "object",
        "required": [
          "name",
          "source_path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.list",
      "summary": "项目列表（含集数统计）",
      "params": {},
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/Project"
        }
      }
    },
    {
      "name": "project.get",
      "summary": "项目详情 + 集列表",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "project",
          "episodes"
        ],
        "properties": {
          "project": {
            "$ref": "#/x-models/Project"
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/Episode"
            }
          }
        }
      }
    },
    {
      "name": "project.delete",
      "summary": "删除项目（级联删集与分析结果）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "project.rename",
      "summary": "重命名项目",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "name"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.update_settings",
      "summary": "项目级参数覆盖（默认+覆盖机制的存储落点）；null 值=恢复该项默认",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "settings"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "description": "与现有覆盖集做键级合并；某键值为 null 表示删除该键",
            "additionalProperties": true
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "project_id",
          "settings"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "description": "合并后的完整项目级覆盖集"
          }
        }
      }
    },
    {
      "name": "project.duplicate",
      "summary": "复制项目元数据与集列表（分析结果不复制；settings 覆盖值带过去）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.dashboard_summary",
      "summary": "工作台统计（项目数/集数/已分析集数/导出数）",
      "params": {},
      "result": {
        "type": "object",
        "required": [
          "project_count",
          "episode_count",
          "analyzed_episodes",
          "export_count"
        ],
        "properties": {
          "project_count": {
            "type": "integer"
          },
          "episode_count": {
            "type": "integer"
          },
          "analyzed_episodes": {
            "type": "integer"
          },
          "export_count": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "project.scan_episodes",
      "summary": "扫描项目目录登记集（ffprobe 逐文件时长/大小，返回登记结果）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/ScannedEpisode"
        }
      }
    },
    {
      "name": "project.ensure_covers",
      "summary": "为缺封面的项目补截帧（幂等）",
      "params": {
        "type": "object",
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "generated"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "generated": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "project.reorder_episodes",
      "summary": "手动排序：按给定 episode_ids 顺序重编号（1..N）",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "episode_ids"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "episode_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  ]
}