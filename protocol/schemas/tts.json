{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/tts.json",
  "title": "tts 命名空间",
  "namespace": "tts",
  "x-methods": [
    {
      "name": "tts.preview",
      "summary": "试听：用指定（缺省取当前生效）引擎+音色合成一句短句，返回本机音频路径供播放",
      "params": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string",
            "description": "kokoro | edge；缺省取设置项 tts.engine。未接入工厂的引擎直接报错，不换个引擎出声"
          },
          "voice": {
            "type": "string",
            "description": "该引擎的音色名；缺省取设置项 tts.voice.<engine>。引擎会静默回退的音色名直接报错（-32320）"
          },
          "text": {
            "type": "string",
            "maxLength": 60,
            "description": "缺省为服务端固定试听短句（PREVIEW_TEXT）；上限 60 字——长文是出片不是试听"
          }
        }
      },
      "result": {
        "type": "object",
        "required": ["path", "duration_s", "engine", "voice", "text"],
        "properties": {
          "path": {
            "type": "string",
            "description": "合成产物的绝对路径（cache/tts-preview/ 下，按 引擎|音色|文案 内容寻址，可反复播）"
          },
          "duration_s": {
            "type": "number",
            "description": "ffprobe 实测秒数；≤0 视为失败并报错，不返回空样本"
          },
          "engine": { "type": "string" },
          "voice": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    {
      "name": "tts.clean_reference",
      "summary": "参考音频清洗：剥底噪/BGM 改善克隆参考，返回产物路径与产物质检报告",
      "params": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "参考音频本机路径（如引擎页选择的克隆参考）"
          },
          "mode": {
            "type": "string",
            "enum": ["separate", "fast"],
            "description": "separate=MDX-Net 人声分离（默认，需 TTS 运行环境+首次下载约 50MB 模型）；fast=ffmpeg 滤镜链（零依赖，只压底噪不剥 BGM）"
          }
        }
      },
      "result": {
        "type": "object",
        "required": ["path", "quality"],
        "properties": {
          "path": {
            "type": "string",
            "description": "清洗产物绝对路径（<stem>.cleaned.wav，与源同目录）；前端将其接替为当前参考"
          },
          "quality": {
            "type": "object",
            "required": ["grade"],
            "properties": {
              "grade": { "type": "string", "description": "good | fair | poor（B6 质检口径）" },
              "metrics": { "type": "object", "description": "duration_s/rms_dbfs/peak_dbfs/clip_ratio/snr_db" },
              "reasons": { "type": "array", "items": { "type": "string" } },
              "suggestions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  ]
}
