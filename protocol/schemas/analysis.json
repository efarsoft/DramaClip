{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/analysis.json",
  "title": "analysis 命名空间（W2：阶段二精准分析；prescreen 见 W10）",
  "namespace": "analysis",
  "x-models": {
    "AsrSegment": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "type": "number" },
        "end": { "type": "number" },
        "text": { "type": "string" },
        "speaker": { "type": "string" },
        "emotion": { "type": "string" }
      }
    },
    "EpisodeAnalysisResult": {
      "type": "object",
      "required": ["episode_id", "episode_number", "status", "asr_segment_count", "scene_count", "highlight_count"],
      "properties": {
        "episode_id": { "type": "string" },
        "episode_number": { "type": "integer" },
        "status": { "type": "string" },
        "asr_segment_count": { "type": "integer" },
        "scene_count": { "type": "integer" },
        "highlight_count": { "type": "integer" },
        "genre": { "type": "string" },
        "error": { "type": "string" },
        "prescreen_score": {
          "type": ["number", "null"],
          "description": "预筛综合分（0-100）；null = 该集没预筛过"
        },
        "recommended": {
          "type": ["boolean", "null"],
          "description": "预筛推荐判定（金色覆盖度告警的数据源）；null = 没预筛过"
        },
        "clipping": {
          "type": "boolean",
          "description": "源音频进仓已削顶：成片限幅只能压电平，不能把平顶长回来"
        },
        "peak_dbfs": { "type": ["number", "null"] }
      }
    },
    "AnalysisJobStatus": {
      "type": "object",
      "required": ["job_id", "status", "progress"],
      "properties": {
        "job_id": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "message": { "type": "string" },
        "error": { "type": "string" },
        "episodes": {
          "type": "array",
          "items": { "type": "object", "required": ["episode_id", "status"], "properties": { "episode_id": { "type": "string" }, "status": { "type": "string" } } }
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "analysis.update_asr",
      "summary": "整列表替换 ASR 段（用户修正转写错误/删幻觉段）；下游语义结果保留",
      "params": {
        "type": "object",
        "required": ["project_id", "episode_id", "segments"],
        "properties": {
          "project_id": { "type": "string" },
          "episode_id": { "type": "string" },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "text"],
              "properties": {
                "start": { "type": "number" },
                "end": { "type": "number" },
                "text": { "type": "string" },
                "speaker": { "type": "string" },
                "emotion": { "type": "string" }
              }
            }
          }
        }
      },
      "result": {
        "type": "object",
        "required": ["ok", "count"],
        "properties": { "ok": { "type": "boolean" }, "count": { "type": "integer" } }
      }
    },
    {
      "name": "analysis.resync_semantic",
      "summary": "仅重跑语义层（修正 ASR 后刷新冲突/高光/题材），不重转写（job 模式）",
      "params": {
        "type": "object",
        "required": ["project_id", "episode_id"],
        "properties": {
          "project_id": { "type": "string" },
          "episode_id": { "type": "string" }
        }
      },
      "result": { "type": "object", "required": ["job_id"], "properties": { "job_id": { "type": "string" } } }
    },
    {
      "name": "analysis.start",
      "summary": "启动精准分析（长任务 job 模式；episode_ids 缺省=全部未完成集）",
      "params": {
        "type": "object",
        "required": ["project_id"],
        "properties": {
          "project_id": { "type": "string" },
          "episode_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "result": { "type": "object", "required": ["job_id"], "properties": { "job_id": { "type": "string" } } }
    },
    {
      "name": "analysis.status",
      "summary": "任务状态与逐集进度",
      "params": { "type": "object", "required": ["job_id"], "properties": { "job_id": { "type": "string" } } },
      "result": { "$ref": "#/x-models/AnalysisJobStatus" }
    },
    {
      "name": "analysis.cancel",
      "summary": "取消任务",
      "params": { "type": "object", "required": ["job_id"], "properties": { "job_id": { "type": "string" } } },
      "result": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" } } }
    },
    {
      "name": "analysis.results",
      "summary": "项目分析结果（含 ASR 全文/冲突曲线/高光，供语义看板与 W4 编排）",
      "params": { "type": "object", "required": ["project_id"], "properties": { "project_id": { "type": "string" } } },
      "result": {
        "type": "object",
        "required": ["episodes"],
        "properties": {
          "episodes": { "type": "array", "items": { "$ref": "#/x-models/EpisodeAnalysisResult" } },
          "asr_segments": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "$ref": "#/x-models/AsrSegment" } }
          },
          "highlights": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["start", "end", "score"],
                "properties": {
                  "start": { "type": "number" },
                  "end": { "type": "number" },
                  "score": { "type": "number" },
                  "reason": { "type": "string" }
                }
              }
            }
          },
          "conflict_scores": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["scene_index", "start", "end", "score"],
                "properties": {
                  "scene_index": { "type": "integer" },
                  "start": { "type": "number" },
                  "end": { "type": "number" },
                  "score": { "type": "integer" },
                  "reason": { "type": "string" }
                }
              }
            }
          },
          "visual_tracks": {
            "type": "object",
            "description": "视觉轨产物（{集 id: VisualTrack}）；未跑视觉轨的集缺席",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "contact_sheet": { "type": "string" },
                "engine": { "type": "string" },
                "frames": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["t", "scene"],
                    "properties": {
                      "t": { "type": "number" },
                      "shot": { "type": "string" },
                      "scene": { "type": "string" },
                      "people": { "type": "string" },
                      "action": { "type": "string" },
                      "mood": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "prescreen": {
            "type": "object",
            "description": "预筛原始行（每集一条）。注意 recommended 在此是库内 0/1 整数；界面判定请用 episodes[].recommended（已转布尔）",
            "additionalProperties": {
              "type": "object",
              "required": ["prescreen_score", "recommended"],
              "properties": {
                "episode_id": { "type": "string" },
                "audio_peak_density": { "type": "number" },
                "scene_cut_density": { "type": "number" },
                "voice_activity_ratio": { "type": "number" },
                "motion_intensity": { "type": "number" },
                "prescreen_score": { "type": "number" },
                "recommended": { "type": "integer" },
                "created_at": { "type": "integer" }
              }
            }
          }
        }
      }
    }
,
    {
      "name": "analysis.export_transcripts",
      "summary": "全部已分析集一次性导出：逐集 SRT + 合并全剧台词 TXT，产物在 data/exports/transcripts/<剧名>/（同步返回）",
      "params": {
        "type": "object",
        "required": ["project_id"],
        "properties": { "project_id": { "type": "string" } }
      },
      "result": {
        "type": "object",
        "required": ["ok", "dir", "txt_path", "files", "exported", "skipped"],
        "properties": {
          "ok": { "type": "boolean" },
          "dir": { "type": "string" },
          "txt_path": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "exported": { "type": "integer" },
          "skipped": { "type": "integer" }
        }
      }
    }
  ]
}