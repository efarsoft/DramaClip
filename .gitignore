# ── 依赖 ──
node_modules/
.venv/

# ── 构建产物 ──
desktop/dist/
desktop/dist-electron/
*.tsbuildinfo
service/build/
service/dist/
# 本地打包重定向出的日志（仓库根）
/build_*_log.txt

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── 运行时数据 / 参考资料（永不入库）──
data/
data-scale/
resources/models/
resources/cache/

# ── 本地环境 ──
.env
.env.local

# ── 临时文件：必须带路径前缀，禁止裸通配（防误伤 __init__.py）──
/tmp_*
/_*.md

# ── IDE / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db

# 会话工作区
.zcode/
.superpowers/

# 本地测试素材
tmp_w2_media/

# ── sidecar 构建产物（随安装包分发，不入库）──
resources/dramaclip-service/
build/
desktop/release/
desktop/release2/
# desktop/build 是 electron-builder buildResources：NSIS 卸载脚本与应用图标必须入库
# （干净 checkout 缺 icon.ico 时打包回退默认 Electron 图标）；其余构建产物照旧忽略
!desktop/build/
desktop/build/*
!desktop/build/installer.nsh
!desktop/build/icon.ico

# ── 本地调试产物（永不入库）──
scratch/
/*ANALYSIS.md

# 会话/代理工具的工作区与状态（不入库：会话转录、调研产物、计划文件）
.agnes/
.adnify/
.claude/
.cursor/
.workbuddy/

# 本地临时目录（曾误写成 ../tmp-rel/——那指向仓库外一级，永远匹配不到）
tmp-rel/
