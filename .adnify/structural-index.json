{"bm25":{"documents":[{"id":"D:\\DramaClip\\app\\backend_main.py:0","filePath":"D:\\DramaClip\\app\\backend_main.py","relativePath":"app\\backend_main.py","content":"\"\"\"\nBackend 入口点\n通过 PyInstaller 打包为 backend.exe\n\"\"\"","startLine":1,"endLine":4,"type":"block","language":"python","symbols":[],"termFreq":[["backend",2],["pyinstaller",1],["exe",1]],"docLength":4},{"id":"D:\\DramaClip\\app\\backend_main.py:16","filePath":"D:\\DramaClip\\app\\backend_main.py","relativePath":"app\\backend_main.py","content":"def setup_logging():\n    \"\"\"配置日志\"\"\"\n    # 开发模式输出到 stderr，生产模式输出到文件\n    log_dir = Path.home() / \".dramaclip\" / \"logs\"\n    log_dir.mkdir(parents=True, exist_ok=True)\n\n    logger.add(\n        log_dir / \"backend.log\",\n        rotation=\"10 MB\",\n        retention=\"7 days\",\n        level=\"DEBUG\",\n        format=\"{time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} - {message}\"\n    )\n\n    # 开发模式也输出到 stderr\n    if not getattr(sys, 'frozen', False):\n        logger.add(\n            sys.stderr,\n            level=\"DEBUG\",\n            format=\"{time:HH:mm:ss} | {level} | {message}\"\n        )","startLine":17,"endLine":37,"type":"function","language":"python","symbols":["setup_logging"],"termFreq":[["def",1],["setup_logging",1],["stderr",3],["log_dir",3],["path",1],["home",1],["dramaclip",1],["logs",1],["mkdir",1],["parents",1],["true",2],["exist_ok",1],["logger",2],["add",2],["backend",1],["log",1],["rotation",1],["mb",1],["retention",1],["days",1],["level",4],["debug",2],["format",2],["time",2],["yyyy",1],["mm",3],["dd",1],["hh",2],["ss",2],["name",1],["function",1],["line",1],["message",2],["if",1],["not",1],["getattr",1],["sys",2],["frozen",1],["false",1]],"docLength":58},{"id":"D:\\DramaClip\\app\\backend_main.py:39","filePath":"D:\\DramaClip\\app\\backend_main.py","relativePath":"app\\backend_main.py","content":"def setup_resources():\n    \"\"\"配置资源路径\"\"\"\n    if getattr(sys, 'frozen', False):\n        # PyInstaller 打包模式\n        # sys._MEIPASS 指向临时解压目录\n        base_dir = Path(sys._MEIPASS)\n        # 可执行文件所在目录（安装目录/backend/）\n        exe_dir = Path(sys.executable).parent\n    else:\n        base_dir = project_root\n        exe_dir = project_root\n\n    # FFmpeg 路径查找（按优先级）\n    ffmpeg_candidates = [\n        exe_dir / \"resources\",           # 安装目录/backend/resources/\n        base_dir / \"resources\",          # PyInstaller 临时目录/resources/\n        exe_dir.parent / \"resources\",    # 安装目录/resources/\n    ]\n    \n    for ffmpeg_dir in ffmpeg_candidates:\n        if ffmpeg_dir.exists():\n            os.environ[\"DRAMACLIP_FFMPEG_PATH\"] = str(ffmpeg_dir)\n            logger.info(f\"FFmpeg path set to: {ffmpeg_dir}\")\n            break\n\n    # 模型路径\n    models_candidates = [\n        exe_dir / \"resources\" / \"models\",\n        base_dir / \"resources\" / \"models\",\n        exe_dir.parent / \"resources\" / \"models\",\n    ]\n    \n    for models_dir in models_candidates:\n        if models_dir.exists():\n            os.environ[\"DRAMACLIP_MODELS_PATH\"] = str(models_dir)\n            logger.info(f\"Models path set to: {models_dir}\")\n            break\n\n    return base_dir","startLine":40,"endLine":78,"type":"function","language":"python","symbols":["setup_resources"],"termFreq":[["def",1],["setup_resources",1],["if",3],["getattr",1],["sys",4],["frozen",1],["false",1],["pyinstaller",2],["_meipass",2],["base_dir",5],["path",4],["backend",2],["exe_dir",6],["executable",1],["parent",3],["else",1],["project_root",2],["ffmpeg",2],["ffmpeg_candidates",2],["resources",9],["for",2],["ffmpeg_dir",4],["in",2],["exists",2],["os",2],["environ",2],["dramaclip_ffmpeg_path",1],["str",2],["logger",2],["info",2],["set",2],["to",2],["break",2],["models_candidates",2],["models",4],["models_dir",4],["dramaclip_models_path",1],["return",1]],"docLength":92},{"id":"D:\\DramaClip\\app\\backend_main.py:80","filePath":"D:\\DramaClip\\app\\backend_main.py","relativePath":"app\\backend_main.py","content":"def main():\n    \"\"\"主入口\"\"\"\n    base_dir = setup_resources()\n    setup_logging()\n\n    logger.info(\"=\" * 60)\n    logger.info(\"DramaClip Backend starting...\")\n    logger.info(f\"Python version: {sys.version}\")\n    logger.info(f\"Working directory: {os.getcwd()}\")\n    logger.info(f\"Base directory: {base_dir}\")\n    logger.info(\"=\" * 60)\n\n    try:\n        from app.ipc.server import IpcServer\n        from app.ipc.router import create_router\n\n        # 创建路由\n        router = create_router()\n        logger.info(f\"Registered methods: {router.list_methods()}\")\n\n        # 创建 IPC 服务器\n        server = IpcServer(router)\n\n        # 注册服务器引用到 handlers，用于发送进度通知\n        from app.ipc import handlers as ipc_handlers\n        ipc_handlers.set_server(server)\n\n        # 发送就绪通知\n        server.send_notification(\"ready\", {\n            \"version\": \"1.0.0\",\n            \"name\": \"DramaClip Backend\",\n            \"timestamp\": int(__import__(\"time\").time() * 1000)\n        })\n\n        # 运行主循环\n        logger.info(\"IPC Server listening on stdin...\")\n        server.run()\n\n    except KeyboardInterrupt:\n        logger.info(\"Received interrupt signal, shutting down...\")\n    except Exception as e:\n        logger.exception(f\"Backend fatal error: {e}\")\n        sys.exit(1)\n    finally:\n        logger.info(\"Backend stopped\")","startLine":81,"endLine":125,"type":"function","language":"python","symbols":["main"],"termFreq":[["def",1],["main",1],["base_dir",2],["setup_resources",1],["setup_logging",1],["logger",11],["info",10],["dramaclip",2],["backend",4],["starting",1],["python",1],["version",3],["sys",2],["working",1],["directory",2],["os",1],["getcwd",1],["base",1],["try",1],["from",3],["app",3],["ipc",5],["server",6],["import",3],["ipcserver",2],["router",4],["create_router",2],["registered",1],["methods",1],["list_methods",1],["handlers",2],["as",2],["ipc_handlers",2],["set_server",1],["send_notification",1],["ready",1],["name",1],["timestamp",1],["int",1],["__import__",1],["time",2],["listening",1],["on",1],["stdin",1],["run",1],["except",2],["keyboardinterrupt",1],["received",1],["interrupt",1],["signal",1],["shutting",1],["down",1],["exception",2],["fatal",1],["error",1],["exit",1],["finally",1],["stopped",1]],"docLength":112},{"id":"D:\\DramaClip\\app\\backend_main.py:gap:4","filePath":"D:\\DramaClip\\app\\backend_main.py","relativePath":"app\\backend_main.py","content":"\nimport sys\nimport os\nfrom pathlib import Path\nfrom loguru import logger\n\n# 添加项目根目录到 Python 路径（app/ 的父目录）\nproject_root = Path(__file__).resolve().parent.parent\nif str(project_root) not in sys.path:\n    sys.path.insert(0, str(project_root))\n\n","startLine":5,"endLine":16,"type":"block","language":"python","symbols":[],"termFreq":[["import",4],["sys",3],["os",1],["from",2],["pathlib",1],["path",4],["loguru",1],["logger",1],["python",1],["app",1],["project_root",3],["__file__",1],["resolve",1],["parent",2],["if",1],["str",2],["not",1],["in",1],["insert",1]],"docLength":32}],"avgDocLength":59.6,"idf":[["backend",0.28768207245178085],["pyinstaller",0.8754687373538999],["exe",1.3862943611198906],["def",0.5389965007326871],["setup_logging",0.8754687373538999],["stderr",1.3862943611198906],["log_dir",1.3862943611198906],["path",0.5389965007326871],["home",1.3862943611198906],["dramaclip",0.8754687373538999],["logs",1.3862943611198906],["mkdir",1.3862943611198906],["parents",1.3862943611198906],["true",1.3862943611198906],["exist_ok",1.3862943611198906],["logger",0.28768207245178085],["add",1.3862943611198906],["log",1.3862943611198906],["rotation",1.3862943611198906],["mb",1.3862943611198906],["retention",1.3862943611198906],["days",1.3862943611198906],["level",1.3862943611198906],["debug",1.3862943611198906],["format",1.3862943611198906],["time",0.8754687373538999],["yyyy",1.3862943611198906],["mm",1.3862943611198906],["dd",1.3862943611198906],["hh",1.3862943611198906],["ss",1.3862943611198906],["name",0.