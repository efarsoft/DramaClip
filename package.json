{
  "name": "dramaclip",
  "private": true,
  "version": "0.2.2",
  "description": "本地优先的短剧自动高光剪辑工具",
  "license": "MIT",
  "workspaces": [
    "desktop",
    "protocol"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "npm run lint --workspace @dramaclip/desktop --if-present",
    "typecheck": "npm run typecheck --workspace @dramaclip/desktop --if-present",
    "test": "npm run test --workspace @dramaclip/desktop --if-present",
    "dist:service": ".venv/Scripts/python.exe scripts/build-service.py",
    "dist": "npm run dist:service && npm run dist --workspace @dramaclip/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@44.2.0": true
  }
}
